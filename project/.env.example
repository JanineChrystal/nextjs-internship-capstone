# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION (Task 2.1)
# ============================================
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk URLs (update these after deploying)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# DATABASE (Task 3.2)
# ============================================
# Option 1: Vercel Postgres
# POSTGRES_URL=your_vercel_postgres_url
# POSTGRES_PRISMA_URL=your_vercel_postgres_prisma_url
# POSTGRES_URL_NON_POOLING=your_vercel_postgres_non_pooling_url

# Option 2: Neon Database
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Option 3: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/projectflow

# ============================================
# OPTIONAL: DEVELOPMENT
# ============================================
# NODE_ENV=development

# ============================================
# NOTES FOR INTERNS
# ============================================
# - Never commit .env.local to git (it's in .gitignore)
# - Store sensitive keys securely
# - Use different keys for development and production
# - Get production keys from your team lead during deployment phase

# ============================================
# RATE LIMITING (Upstash Redis)
# ============================================
# Required - lib/rate-limit.ts throws at import if these are missing.
# Free tier at https://console.upstash.com -> Redis -> "REST API" tab.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ============================================
# CLERK WEBHOOK
# ============================================
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_secret_here

# ============================================
# CONTACT FORM NOTIFICATIONS
# ============================================
# The landing page's contact drawer saves every message to the ContactMessages
# table first, then announces it on whichever of these channels is configured.
#
# BOTH ARE OPTIONAL. With none of these set the form still works and still saves
# every message - it just does not notify anyone. Add one, or both, or neither.
#
# After filling these in, verify them with:   pnpm check:notifiers

# --- Resend (email) ---------------------------------------------------------
# 1. Sign up at https://resend.com and create a key at /api-keys
# 2. FROM address: for testing you may use "onboarding@resend.dev", but that
#    sender can ONLY deliver to the email address on your own Resend account.
#    To email anyone else, add and verify a domain at resend.com/domains and
#    use an address on it, e.g. "Takda PH <hello@yourdomain.com>".
# 3. TO accepts a comma-separated list if more than one person should be told.
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL_FROM=Takda PH <onboarding@resend.dev>
CONTACT_EMAIL_TO=you@example.com

# --- Telegram (push to your phone) ------------------------------------------
# 1. In Telegram, message @BotFather and send /newbot. Follow the prompts.
#    It replies with a token that looks like 123456789:AAE...  -> BOT_TOKEN
# 2. Open your new bot and send it any message (e.g. "hi"). This is required:
#    a bot cannot see a chat until someone has written to it first.
# 3. Run `pnpm check:notifiers` - with the token set and the chat id still
#    blank, it prints the chat ids the bot can see. Copy one in below.
#    (To alert a group instead: add the bot to the group, send a message
#    there, and re-run the script - the group id will be negative.)
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
