# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION (Task 2.1)
# ============================================
# Get your keys from https://clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
# CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk URLs (update these after deploying)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# DATABASE (Task 3.2)
# ============================================
# Option 1: Vercel Postgres
# POSTGRES_URL=your_vercel_postgres_url
# POSTGRES_PRISMA_URL=your_vercel_postgres_prisma_url
# POSTGRES_URL_NON_POOLING=your_vercel_postgres_non_pooling_url

# Option 2: Neon Database
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Option 3: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/projectflow

# --- Migrating the other Neon branches ---
# DATABASE_URL above is the DEVELOPMENT branch, and pnpm db:migrate only ever
# touches that one. Every other environment is its own Neon branch and has to
# be migrated deliberately, using the variable named after it:
#
#   pnpm db:migrate:integration   reads INTEGRATION_DATABASE_URL
#   pnpm db:migrate:preview       reads PREVIEW_DATABASE_URL
#   pnpm db:migrate:production    reads PRODUCTION_DATABASE_URL
#
# Use each branch DIRECT (unpooled) connection string - the host WITHOUT
# "-pooler" in it. DDL through a connection pooler is the usual cause of a
# migration that hangs.
#
# Leave these blank when you are not migrating. Each config throws if its
# variable is missing, which turns an absent-minded run into an error rather
# than a migration against the wrong database.
# INTEGRATION_DATABASE_URL=
# PREVIEW_DATABASE_URL=
# PRODUCTION_DATABASE_URL=

# ============================================
# OPTIONAL: DEVELOPMENT
# ============================================
# NODE_ENV=development

# ============================================
# NOTES FOR INTERNS
# ============================================
# - Never commit .env.local to git (it's in .gitignore)
# - Store sensitive keys securely
# - Use different keys for development and production
# - Get production keys from your team lead during deployment phase

# ============================================
# RATE LIMITING (Upstash Redis)
# ============================================
# Required - lib/rate-limit.ts throws at import if these are missing.
# Free tier at https://console.upstash.com -> Redis -> "REST API" tab.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# ============================================
# CLERK WEBHOOK
# ============================================
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
# CLERK_WEBHOOK_SECRET=whsec_your_secret_here

# ============================================
# CONTACT FORM NOTIFICATIONS
# ============================================
# The landing page's contact drawer saves every message to the ContactMessages
# table first, then announces it on whichever of these channels is configured.
#
# BOTH ARE OPTIONAL. With none of these set the form still works and still saves
# every message - it just does not notify anyone. Add one, or both, or neither.
#
# After filling these in, verify them with:   pnpm check:notifiers

# --- SendGrid (email) -------------------------------------------------------
# Used for BOTH the contact-form alert and every in-app notification email.
#
# 1. Sign up at https://sendgrid.com
# 2. Verify a sender: Settings > Sender Authentication > Single Sender
#    Verification. This proves ONE email address - a Gmail account is fine -
#    and is why no domain is needed. Resend has no equivalent: it verifies per
#    domain only, which is what forced this switch.
# 3. Create a key: Settings > API Keys > Restricted Access, Mail Send only.
#    The key is shown exactly once.
# 4. CONTACT_EMAIL_FROM must match the verified sender EXACTLY. Any other
#    address is a 403 on every send while looking perfectly reasonable here.
#
# Deliverability note: mail sent as a gmail.com address through SendGrid is not
# DKIM-aligned with gmail.com, so it may show "via sendgrid.net" and is likelier
# to land in spam. Check the spam folder before concluding a send failed.
#
# Verify with:   pnpm check:notifiers --no-send
# SENDGRID_API_KEY=SG.your_key_here
# CONTACT_EMAIL_FROM=Takda PH <your-verified-sender@gmail.com>
# CONTACT_EMAIL_TO=you@example.com

# --- Telegram (push to your phone) ------------------------------------------
# 1. In Telegram, message @BotFather and send /newbot. Follow the prompts.
#    It replies with a token that looks like 123456789:AAE...  -> BOT_TOKEN
# 2. Open your new bot and send it any message (e.g. "hi"). This is required:
#    a bot cannot see a chat until someone has written to it first.
# 3. Run `pnpm check:notifiers` - with the token set and the chat id still
#    blank, it prints the chat ids the bot can see. Copy one in below.
#    (To alert a group instead: add the bot to the group, send a message
#    there, and re-run the script - the group id will be negative.)
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# COMMENT MODERATION (Phase 6)
# ============================================
# Both are OPTIONAL. With neither set, moderation still works: English profanity
# is caught by a local word list, and the Filipino API defaults to its public
# deployment. Verify with:   pnpm check:profanity

# Override only to point at your own deployment of
# github.com/jobelGolde12/filipino_profanity_api_latest
# Must be the API base (ending in /api), NOT the site root.
# FILIPINO_PROFANITY_API_URL=https://your-deployment.vercel.app/api

# The public API needs no key. Sent as a Bearer token if you add auth later.
# FILIPINO_PROFANITY_API_KEY=

# ============================================
# APPLICATION ENCRYPTION
# ============================================
# REQUIRED. 32 bytes expressed as 64 hex characters.
#
# Encrypts the columns that hold private content: comment bodies, contact-form
# messages, activity-log details, notification messages and checklist titles.
# Identifiers - email addresses and names - are deliberately NOT encrypted,
# because the app matches and searches on them.
#
# There is no fallback. The app throws if this is missing, rather than quietly
# using a constant key that would be visible to anyone reading this repository.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Use the SAME key in every environment. A key and the data it wrote must stay
# paired, and these databases are copies of one another - the Integration branch
# was cut from Preview, so rows encrypted under one key travel into the other.
# Separate keys per environment only work if no database is ever branched or
# restored from another, which is not how this project is set up.
#
# If the key and the data disagree, encrypted fields render as raw ciphertext
# rather than failing loudly - so a mismatch is quiet, and worth avoiding.
#
# After changing it, move existing rows across with:  pnpm db:migrate-encryption
# ENCRYPTION_KEY=

# --- Playwright end-to-end tests ---
# Where the E2E suite runs. Unset, Playwright boots a local `next start`.
# Set it to the deployed development branch to test what is actually shipped.
# E2E_BASE_URL=https://your-app-git-develop.vercel.app
# A real Clerk account the suite signs in as. Use a dedicated test user, not
# your own: the tests create projects and tasks under whoever this is.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# The runbook uses three accounts: A owns the workspace, B is invited, C is a
# second member or guest. Only A is required - the multi-user specs skip
# themselves when B or C is missing.
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=
# E2E_USER_C_EMAIL=
# E2E_USER_C_PASSWORD=
#
# IMPORTANT: use +clerk_test addresses, e.g. you+clerk_test@gmail.com
# Clerk asks a brand new browser to verify the device by emailing a code, and
# Playwright is always a new browser. A development instance (pk_test_...)
# accepts the fixed code 424242 for any +clerk_test address, so no inbox is
# needed. Sign each one up once through /sign-up first - the same code works
# there. Gmail delivers the +suffix to your normal inbox, and the app's
# @gmail.com rule allows it.

# Vercel Blob - file attachments on tasks.
# Create a Blob store in the Vercel dashboard (Storage tab); Vercel injects this
# automatically on deployments. For local development, copy it from
# Storage -> your store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=
